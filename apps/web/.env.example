# Auth/session signing secret. 32+ characters. REQUIRED in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Optional. When "true", sign-in is required. Left unset, WebStrike runs in
# guest mode and goes straight to the app. Scope validation, SSRF protection
# and rate limits remain enforced either way.
REQUIRE_AUTH=

# Optional. Only account data is stored here — never testing results.
# PostgreSQL (Neon) via Drizzle. Without this, accounts live in process memory.
DATABASE_URL=

# Optional. Enables the Phase 5 browser checks page. Must be a CDP-compatible
# websocket endpoint (e.g. a hosted browser service). Nothing runs locally.
BROWSER_WS_ENDPOINT=
BROWSER_API_TOKEN=
